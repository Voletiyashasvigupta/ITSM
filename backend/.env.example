# Copy to .env and fill values from an authorized ServiceNow instance.
# Never commit .env or paste production credentials into source files.
SERVICENOW_BASE_URL=https://your-instance.service-now.com
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
SERVICENOW_TOKEN_URI=https://your-instance.service-now.com/oauth_token.do

# Copy this file to .env and set every blank secret before starting the stack.
# Generate unique values locally; do not commit .env or reuse secrets between environments.
MYSQL_USER=northstar
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
RABBITMQ_USER=northstar
RABBITMQ_PASSWORD=

# JWT_SIGNING_SECRET must be at least 32 bytes and must match across Auth, Request, and Gateway.
JWT_SIGNING_SECRET=
JWT_ISSUER_URI=northstar-auth
JWT_AUDIENCE=northstar-portal
BOOTSTRAP_ADMIN_EMAIL=admin@northstar.local
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Northstar Administrator

# Keep false outside local test environments. Enables manager/admin user impersonation in the portal.
PORTAL_IMPERSONATION_ENABLED=false
