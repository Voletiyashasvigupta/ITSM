          "raw": "{\n  \"shortDescription\": \"Upgrade application server\",\n  \"detailedDescription\": \"Upgrade application server to approved release\",\n  \"requestedBy\": \"Sravanthi\",\n  \"requesterEmail\": \"sravanthi@example.com\",\n  \"department\": \"IT\",\n  \"changeType\": \"NORMAL\",\n  \"category\": \"APPLICATION\",\n  \"priority\": \"MEDIUM\",\n  \"riskLevel\": \"MEDIUM\",\n  \"impact\": \"Brief application restart\",\n  \"affectedCi\": \"APP-SERVER-01\",\n  \"businessJustification\": \"Security and performance updates\",\n  \"implementationPlan\": \"Deploy during maintenance window\",\n  \"rollbackPlan\": \"Restore previous release\",\n  \"testPlan\": \"Smoke and regression tests\",\n  \"plannedStartDate\": \"2026-12-01T22:00:00\",\n  \"plannedEndDate\": \"2026-12-01T23:00:00\"\n}",
